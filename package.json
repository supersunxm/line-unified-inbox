{
  "name": "oppo-line-oa-monitor-workspace",
  "private": true,
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "dev:restart": "bash scripts/dev-restart.sh all",
    "dev:status": "bash scripts/dev-status.sh",
    "health": "bash scripts/health-check.sh",
    "verify": "bash scripts/verify-all.sh",
    "diagnostics": "bash scripts/collect-diagnostics.sh",
    "deploy:check": "bash scripts/deploy-check.sh",
    "review": "bash scripts/review-diff.sh",
    "logs:backend": "bash scripts/follow-log.sh backend",
    "logs:frontend": "bash scripts/follow-log.sh frontend",
    "line-chat:login": "npm --prefix backend run line-chat:login --",
    "line-chat:nickname": "npm --prefix backend run line-chat:nickname --",
    "line-chat:diagnose": "npm --prefix backend run line-chat:diagnose --",
    "seed:line-chat-test": "npm --prefix backend run seed:line-chat-test",
    "worker:line-chat-nickname": "npm --prefix backend run worker:line-chat-nickname",
    "line-chat:mapping:import": "npm --prefix backend run line-chat:mapping:import --"
  }
}
