#!/bin/sh
# Agent CI gate proposed for explicit owner-approved policy migration.
# Exact committed source, reviewed target/branch allowlist and full evidence only.
# Never use --no-verify; this local safeguard is not server-side protection.
set -eu
root=$(git rev-parse --show-toplevel) || exit 1
gate="$root/tools/codex-ci/agent-pre-push-gate.mjs"
if ! command -v node >/dev/null 2>&1 || [ ! -f "$gate" ]; then
  echo "pre-push: BLOCKED — Node or the reviewed Agent CI gate is unavailable" >&2
  exit 1
fi
exec node "$gate" hook "$@"
