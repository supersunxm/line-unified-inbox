generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum FollowUpStatus {
  FOLLOW_UP
  REMINDED
  ACKNOWLEDGED
  COMPLETED
  ESCALATED
}

enum BmReplyStatus {
  NOT_REPLIED
  NOTIFIED_BM
  REPLIED
}

enum ProductRelationship {
  INTERESTED
  CURRENT_OWNER
  PREVIOUS_OWNER
  UNKNOWN
}

enum ProductGroup {
  SMARTPHONE
  TABLET
  WEARABLE
  AUDIO
  TV
  SMART_HOME_AIOT
  ACCESSORIES
  SERVICE_AFTER_SALES
  UNKNOWN
}

enum ProductAliasSource {
  CATALOG
  MANUAL
}

enum PurchaseIntent {
  LOW
  MEDIUM
  HIGH
  AFTER_SALES
  UNKNOWN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  LOCATION
  STICKER
  UNSUPPORTED
}

enum MediaProcessingStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum LineOaConnectionStatus {
  CONNECTED
  READY
  NOT_CONFIGURED
  ERROR
  DISABLED
}

enum TopicCategory {
  SALES
  PRODUCT_FEATURE
  PURCHASE_JOURNEY
  AFTER_SALES
  COMPLAINT
  GENERAL
}

enum ActivityActionType {
  STATUS_CHANGED
  NOTE_ADDED
  REMINDER_SENT
  MANAGER_ACKNOWLEDGED
  CONVERSATION_COMPLETED
  ESCALATED
  RETURNED_TO_FOLLOW_UP
  MESSAGE_RECEIVED
  CLASSIFICATION_UPDATED
  BM_REPLY_STATUS_CHANGED
}

enum ProfileFetchStatus {
  NOT_REQUESTED
  SUCCESS
  FAILED
  TOKEN_UNAVAILABLE
  USER_UNAVAILABLE
}

enum StoreMasterDataQualityStatus {
  COMPLETE
  MISSING_STORE_ID
  INVALID_MANAGER_URL
  DUPLICATE_ACCOUNT_NAME
  INCOMPLETE
}

enum StoreMetadataSource {
  MASTER
  PROVINCE_MAPPING
  AI_SUGGESTED
  MANUAL
}

enum UserRole {
  ADMIN
  VIEWER
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  REJECTED
}

enum StoreMembershipRole {
  STORE_MANAGER
  STAFF
}

enum MembershipStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RegistrationRequestStatus {
  OTP_PENDING
  PENDING_APPROVAL
  APPROVED
  COMPLETED
  REJECTED
  EXPIRED
}

enum MobileOtpPurpose {
  BM_STAFF_REGISTRATION
  BM_STAFF_LOGIN
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum PushNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum SessionType {
  WEB
  MOBILE
}

enum TranslationFeedbackRating {
  HELPFUL
  INCORRECT
}

enum TranslationFeedbackIssueCategory {
  MEANING_ISSUE
  TERMINOLOGY_ISSUE
  OTHER
}

enum TranslationEventStatus {
  SUCCESS
  FAILED
}

enum PilotChecklistStatus {
  NOT_TESTED
  PASSED
  FAILED
  NOT_APPLICABLE
}

enum OtpPurpose {
  FIRST_ADMIN_REGISTRATION
  USER_INVITATION
  PASSWORD_RESET
}

model User {
  id                   String                       @id @default(uuid())
  username             String?                      @unique
  email                String                       @unique
  normalizedEmail      String                       @unique
  displayName          String
  passwordHash         String?
  role                 UserRole                     @default(VIEWER)
  status               UserStatus                   @default(ACTIVE)
  isActive             Boolean                      @default(true)
  phone                String?                      @unique
  firstName            String?
  lastName             String?
  employeeId           String?
  position             String?
  emailVerifiedAt      DateTime?
  phoneVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  sessions             Session[]
  memberships          UserStoreMembership[]        @relation("UserMemberships")
  approvedMemberships  UserStoreMembership[]        @relation("MembershipApprover")
  registrationRequests RegistrationRequest[]        @relation("CreatedRegistrationUser")
  otpChallenges        OtpChallenge[]
  deviceTokens         DeviceToken[]
  pushNotifications    PushNotification[]
  translationFeedback  MessageTranslationFeedback[]
  operationalSessions  OperationalSession[]
  sentMessages         Message[]                    @relation("MessageSender")
  auditLogsAsActor     AuditLog[]                   @relation("AuditActor")
  auditLogsAsTarget    AuditLog[]                   @relation("AuditTargetUser")
  massMessageCampaigns MassMessageCampaign[]        @relation("CreatedMassMessageCampaigns")

  @@index([status])
  @@index([employeeId])
}

model AdminRegistrationOtp {
  id                String     @id @default(uuid())
  email             String
  normalizedEmail   String
  codeHash          String
  purpose           OtpPurpose
  expiresAt         DateTime
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([normalizedEmail])
  @@index([purpose])
  @@index([expiresAt])
  @@index([consumedAt])
}

model EmailDeliveryEvent {
  id                 String   @id @default(uuid())
  provider           String
  recipientEmailHash String
  purpose            String
  success            Boolean
  sanitizedError     String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([purpose, createdAt])
}

model Session {
  id          String      @id @default(uuid())
  tokenHash   String      @unique
  userId      String
  sessionType SessionType @default(WEB)
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserStoreMembership {
  id           String              @id @default(uuid())
  userId       String
  storeId      String
  role         StoreMembershipRole
  status       MembershipStatus    @default(PENDING_APPROVAL)
  isPrimary    Boolean             @default(true)
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user       User  @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  store      Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("MembershipApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, storeId])
  @@index([storeId, status])
  @@index([userId, status])
}

model RegistrationRequest {
  id              String                    @id @default(uuid())
  storeId         String
  email           String
  normalizedEmail String
  passwordHash    String?
  phone           String?
  firstName       String?
  lastName        String?
  employeeId      String?
  position        String?
  requestedRole   StoreMembershipRole       @default(STAFF)
  status          RegistrationRequestStatus @default(OTP_PENDING)
  otpVerifiedAt   DateTime?
  expiresAt       DateTime
  createdUserId   String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdUser   User?          @relation("CreatedRegistrationUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  auditLogs     AuditLog[]
  otpChallenges OtpChallenge[]

  @@index([phone, status])
  @@index([normalizedEmail, status])
  @@index([employeeId, storeId])
  @@index([expiresAt])
}

model AuthRateLimitBucket {
  id          String   @id @default(uuid())
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([key, windowStart])
  @@index([updatedAt])
}

model AuditLog {
  id                     String   @id @default(uuid())
  actorUserId            String?
  action                 String
  targetUserId           String?
  targetRegistrationId   String?
  metadata               Json?
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime @default(now())

  actorUser              User?                @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser             User?                @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetRegistration     RegistrationRequest? @relation(fields: [targetRegistrationId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model OtpChallenge {
  id                String           @id @default(uuid())
  registrationId    String?
  userId            String?
  normalizedPhone   String
  purpose           MobileOtpPurpose
  codeHash          String
  expiresAt         DateTime
  attempts          Int              @default(0)
  maxAttempts       Int              @default(5)
  resendAvailableAt DateTime
  verifiedAt        DateTime?
  consumedAt        DateTime?
  createdAt         DateTime         @default(now())

  registration RegistrationRequest? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([normalizedPhone, purpose])
  @@index([registrationId])
  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model DeviceToken {
  id           String         @id @default(uuid())
  userId       String
  // The token value is encrypted before persistence. tokenHash supports secure lookup and deduplication.
  token        String         @unique
  tokenHash    String?        @unique
  platform     DevicePlatform
  appVersion   String?
  deviceIdHash String?
  isActive     Boolean        @default(true)
  lastSeenAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model PushNotification {
  id             String                 @id @default(uuid())
  userId         String
  conversationId String
  messageId      String
  type           String
  payload        Json
  status         PushNotificationStatus @default(PENDING)
  attemptCount   Int                    @default(0)
  lastError      String?
  sentAt         DateTime?
  readAt         DateTime?
  openedAt       DateTime?
  createdAt      DateTime               @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([conversationId, createdAt])
  @@index([messageId])
}

model OperationalError {
  id        String   @id @default(uuid())
  feature   String
  summary   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}

model OperationalSession {
  id        String   @id @default(uuid())
  resetAt   DateTime @default(now())
  resetById String?
  resetBy   User?    @relation(fields: [resetById], references: [id], onDelete: SetNull)
  type      String   @default("GLOBAL")
  createdAt DateTime @default(now())

  @@index([resetAt])
  @@index([createdAt])
}

model Store {
  id                   String                @id @default(uuid())
  name                 String
  code                 String?               @unique
  region               String?
  area                 String?
  isActive             Boolean               @default(true)
  archivedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  storeMasterId        String?               @unique
  provinceSource       StoreMetadataSource?
  regionSource         StoreMetadataSource?
  storeMaster          StoreMaster?          @relation(fields: [storeMasterId], references: [id], onDelete: SetNull)
  lineOfficialAccounts LineOfficialAccount[]
  conversations        Conversation[]
  friendSourceLinks    FriendSourceLink[]
  memberships          UserStoreMembership[]
  registrationRequests RegistrationRequest[]
  massMessageStoreDeliveries MassMessageStoreDelivery[]

  @@index([isActive])
  @@index([isActive, archivedAt])
  @@index([region])
}

model StoreMaster {
  id                    String                       @id @default(uuid())
  externalStoreId       String?
  storeName             String
  accountName           String
  normalizedAccountName String
  lineOaLink            String?
  lineId                String?
  lineManagerUrl        String?
  province              String?
  region                String?
  source                String
  sourceRowNumber       Int
  sourceUpdatedAt       DateTime?
  dataQualityStatus     StoreMasterDataQualityStatus
  isActive              Boolean                      @default(true)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  stores                Store[]

  @@unique([source, sourceRowNumber])
  @@index([normalizedAccountName])
  @@index([externalStoreId])
  @@index([lineId])
  @@index([province])
  @@index([region])
  @@index([isActive])
}

enum BackfillJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model LineOfficialAccount {
  id                          String                             @id @default(uuid())
  webhookKey                  String                             @unique
  name                        String
  basicId                     String?                            @unique
  channelId                   String?                            @unique
  destinationId               String?                            @unique
  encryptedChannelSecret      String?
  encryptedChannelAccessToken String?
  lineChatWorkspaceUrl        String?
  connectionStatus            LineOaConnectionStatus             @default(NOT_CONFIGURED)
  lastWebhookReceivedAt       DateTime?
  lastConnectionTestAt        DateTime?
  lastConnectionError         String?
  storeId                     String
  isActive                    Boolean                            @default(true)
  archivedAt                  DateTime?
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt
  lastBackfillReconciledAt    DateTime?
  store                       Store                              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversations               Conversation[]
  webhookEvents               WebhookEvent[]
  pilotChecklist              PilotChecklistItem[]
  followerSnapshots           LineOaFollowerSnapshot[]
  backfillJobs                LineOaBackfillJob[]
  friendSourceLinks           FriendSourceLink[]
  attributionSessions         FriendAttributionSession[]
  unmatchedFollows            FriendAttributionUnmatchedFollow[]
  friendAttributionConfig     FriendAttributionConfig?
  massMessageStoreDeliveries  MassMessageStoreDelivery[]

  @@index([storeId, isActive])
  @@index([isActive, lastBackfillReconciledAt])
}

model LineOaBackfillJob {
  id            String            @id @default(uuid())
  lineOaId      String
  workerId      String?
  status        BackfillJobStatus @default(QUEUED)
  dateFrom      String
  dateTo        String
  totalDays     Int               @default(0)
  requested     Int               @default(0)
  succeeded     Int               @default(0)
  skipped       Int               @default(0)
  unready       Int               @default(0)
  failed        Int               @default(0)
  attempts      Int               @default(0)
  maxAttempts   Int               @default(3)
  errorMessage  String?
  claimedAt     DateTime?
  heartbeatAt   DateTime?
  nextAttemptAt DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOaId], references: [id], onDelete: Cascade)

  @@index([lineOaId, status])
  @@index([status, heartbeatAt])
  @@index([nextAttemptAt])
  @@index([createdAt])
}

model PilotChecklistItem {
  id                    String               @id @default(uuid())
  lineOfficialAccountId String
  itemKey               String
  status                PilotChecklistStatus @default(NOT_TESTED)
  note                  String?
  updatedAt             DateTime             @updatedAt
  createdAt             DateTime             @default(now())
  lineOfficialAccount   LineOfficialAccount  @relation(fields: [lineOfficialAccountId], references: [id], onDelete: Cascade)

  @@unique([lineOfficialAccountId, itemKey])
  @@index([lineOfficialAccountId])
}

model Customer {
  id                 String                @id @default(uuid())
  lineUserId         String?               @unique
  displayName        String
  pictureUrl         String?
  statusMessage      String?
  preferredLanguage  String?
  profileFetchedAt   DateTime?
  profileFetchStatus ProfileFetchStatus    @default(NOT_REQUESTED)
  profileFetchError  String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  conversations      Conversation[]
  nameHistory        CustomerNameHistory[]
  events             CustomerEvent[]
  signals            CustomerSignal[]
}

enum CustomerEventType {
  NAME_CHANGED
  PRODUCT_INTEREST_DETECTED
  PURCHASE_INTENT_CHANGED
}

enum CustomerEventSource {
  LINE_PROFILE_SYNC
  BM_MANUAL
  AI_ANALYSIS
}

model CustomerEvent {
  id            String              @id @default(uuid())
  customerId    String
  type          CustomerEventType
  source        CustomerEventSource
  previousValue String?
  newValue      String?
  metadata      Json?
  createdAt     DateTime            @default(now())

  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  signals  CustomerSignal[]

  @@index([customerId, createdAt])
  @@index([type, createdAt])
}

enum CustomerSignalType {
  PRODUCT_INTEREST
  PURCHASE_INTENT
  PROMOTION_INTEREST
  PRICE_INQUIRY
  STORE_VISIT_INTENT
  UNKNOWN
}

enum CustomerSignalSource {
  NAME_CHANGE
  MESSAGE_ANALYSIS
  BM_NOTE
  AI_ANALYSIS
}

model CustomerSignal {
  id              String               @id @default(uuid())
  customerId      String
  customerEventId String?
  signalType      CustomerSignalType
  source          CustomerSignalSource @default(NAME_CHANGE)
  productModelId  String?
  detectedText    String?
  confidence      Float                @default(0)
  metadata        Json?
  createdAt       DateTime             @default(now())

  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceEvent  CustomerEvent? @relation(fields: [customerEventId], references: [id], onDelete: SetNull)
  productModel ProductModel?  @relation(fields: [productModelId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([signalType, createdAt])
  @@index([productModelId, createdAt])
  @@index([customerEventId])
}

model CustomerNameHistory {
  id          String   @id @default(uuid())
  customerId  String
  displayName String
  source      String
  capturedAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, capturedAt])
}

model Conversation {
  id                    String                @id @default(uuid())
  customerId            String
  storeId               String
  lineOfficialAccountId String
  latestMessageAt       DateTime
  priority              Priority              @default(NORMAL)
  prioritySource        String                @default("SYSTEM")
  followUpStatus        FollowUpStatus        @default(FOLLOW_UP)
  bmReplyStatus         BmReplyStatus         @default(NOT_REPLIED)
  productRelationship   ProductRelationship?
  purchaseIntent        PurchaseIntent?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  store                 Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lineOfficialAccount   LineOfficialAccount   @relation(fields: [lineOfficialAccountId], references: [id], onDelete: Restrict)
  messages              Message[]
  products              ConversationProduct[]
  topics                ConversationTopic[]
  notes                 InternalNote[]
  activityHistory       ActivityHistory[]
  pushNotifications     PushNotification[]

  @@index([latestMessageAt])
  @@index([followUpStatus])
  @@index([priority])
  @@index([storeId])
  @@index([customerId])
  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, bmReplyStatus])
  @@index([bmReplyStatus, createdAt])
  @@index([storeId, followUpStatus, latestMessageAt(sort: Desc)])
  @@index([lineOfficialAccountId, followUpStatus, latestMessageAt(sort: Desc)])
  @@index([lineOfficialAccountId, bmReplyStatus, latestMessageAt(sort: Desc)])
  @@index([customerId, latestMessageAt(sort: Desc)])
}

model Message {
  id                  String                       @id @default(uuid())
  conversationId      String
  externalMessageId   String?                      @unique
  direction           MessageDirection
  messageType         MessageType                  @default(TEXT)
  originalText        String
  originalLanguage    String?
  translatedThai      String?
  translatedEnglish   String?
  translatedChinese   String?
  rawPayload          Json?
  senderUserId        String?
  senderDisplayName   String?
  fileName            String?
  latitude            Float?
  longitude           Float?
  sentAt              DateTime
  createdAt           DateTime                     @default(now())
  conversation        Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User?                        @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  media               MessageMedia?
  translationFeedback MessageTranslationFeedback[]
  pushNotifications   PushNotification[]

  @@index([conversationId, sentAt])
  @@index([senderUserId])
}

model MessageTranslationFeedback {
  id              String                            @id @default(uuid())
  messageId       String
  adminUserId     String
  targetLanguage  String
  translationHash String
  rating          TranslationFeedbackRating
  issueCategory   TranslationFeedbackIssueCategory?
  createdAt       DateTime                          @default(now())
  message         Message                           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  adminUser       User                              @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@unique([messageId, targetLanguage, adminUserId, translationHash])
  @@index([messageId, targetLanguage])
  @@index([createdAt])
}

model TranslationEvent {
  id             String                 @id @default(uuid())
  messageId      String
  adminId        String
  targetLanguage String
  provider       String
  status         TranslationEventStatus
  durationMs     Int
  characterCount Int
  errorCategory  String?
  createdAt      DateTime               @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([messageId, createdAt])
}

model MessageMedia {
  id                String                @id @default(uuid())
  messageId         String                @unique
  providerMessageId String                @unique
  mediaType         MessageType
  mimeType          String?
  objectKey         String?
  provider          String?
  fileId            String?
  fileSize          Int?
  processingStatus  MediaProcessingStatus @default(PENDING)
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([processingStatus, createdAt])
}

model WebhookEvent {
  id                     String                  @id @default(uuid())
  externalWebhookEventId String                  @unique
  externalMessageId      String?
  eventType              String
  destination            String?
  receivedAt             DateTime                @default(now())
  processedAt            DateTime?
  processingStatus       WebhookProcessingStatus @default(RECEIVED)
  errorMessage           String?
  lineOfficialAccountId  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lineOfficialAccount    LineOfficialAccount?    @relation(fields: [lineOfficialAccountId], references: [id], onDelete: SetNull)

  @@index([processingStatus, receivedAt])
  @@index([externalMessageId])
  @@index([lineOfficialAccountId])
}

model ProductSeries {
  id           String         @id @default(uuid())
  name         String         @unique
  isActive     Boolean        @default(true)
  productGroup ProductGroup   @default(UNKNOWN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  models       ProductModel[]

  @@index([isActive])
}

model ProductModel {
  id                  String                @id @default(uuid())
  name                String                @unique
  productSeriesId     String
  isActive            Boolean               @default(true)
  classificationLevel String                @default("MODEL")
  priority            Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  productSeries       ProductSeries         @relation(fields: [productSeriesId], references: [id], onDelete: Restrict)
  conversations       ConversationProduct[]
  aliases             ProductAlias[]
  signals             CustomerSignal[]

  @@index([isActive])
  @@index([productSeriesId])
}

model ProductAlias {
  id              String             @id @default(uuid())
  productModelId  String
  alias           String
  normalizedAlias String             @unique
  language        String?
  isActive        Boolean            @default(true)
  priority        Int                @default(0)
  source          ProductAliasSource @default(MANUAL)
  productModel    ProductModel       @relation(fields: [productModelId], references: [id], onDelete: Cascade)

  @@index([productModelId, isActive])
}

model ConversationProduct {
  conversationId  String
  productModelId  String
  confidence      Float?
  source          String?
  matchedPhrase   String?
  detectionMethod String?
  sourceMessageId String?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  productModel    ProductModel @relation(fields: [productModelId], references: [id], onDelete: Restrict)

  @@id([conversationId, productModelId])
  @@index([productModelId])
}

model Topic {
  id            String              @id @default(uuid())
  name          String              @unique
  category      TopicCategory
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  conversations ConversationTopic[]

  @@index([isActive])
  @@index([category])
}

model ConversationTopic {
  conversationId String
  topicId        String
  confidence     Float?
  source         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  topic          Topic        @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([conversationId, topicId])
  @@index([topicId])
}

model InternalNote {
  id             String       @id @default(uuid())
  conversationId String
  content        String
  createdByName  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ActivityHistory {
  id                    String             @id @default(uuid())
  conversationId        String
  actionType            ActivityActionType
  previousStatus        FollowUpStatus?
  newStatus             FollowUpStatus?
  previousBmReplyStatus BmReplyStatus?
  newBmReplyStatus      BmReplyStatus?
  description           String?
  createdByName         String?
  createdAt             DateTime           @default(now())
  conversation          Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model LineOaFollowerSnapshot {
  id              String   @id @default(uuid())
  lineOaId        String
  snapshotDate    DateTime @db.Date
  status          String
  followers       Int?
  targetedReaches Int?
  blocks          Int?
  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOaId], references: [id], onDelete: Cascade)

  @@unique([lineOaId, snapshotDate])
  @@index([snapshotDate])
  @@index([lineOaId])
}

enum FriendSource {
  STORE_QR
  TIKTOK
  FACEBOOK
  INSTAGRAM
}

enum FriendAttributionStatus {
  PENDING
  CONFIRMED
  EXPIRED
  UNMATCHED
}

enum FriendAttributionSessionStatus {
  CLICKED
  IDENTIFIED
  ALREADY_FRIEND
  ADD_FRIEND_PROMPTED
  CONFIRMED
  EXPIRED
  FAILED
}

model FriendSourceLink {
  id                  String                     @id @default(uuid())
  storeId             String
  lineOaId            String
  source              FriendSource
  shortCode           String                     @unique
  destinationUrl      String
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  store               Store                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lineOa              LineOfficialAccount        @relation(fields: [lineOaId], references: [id], onDelete: Cascade)
  clicks              FriendSourceClick[]
  attributions        FriendSourceAttribution[]
  attributionSessions FriendAttributionSession[]

  @@unique([lineOaId, source])
  @@index([storeId, isActive])
  @@index([lineOaId, isActive])
}

model FriendSourceClick {
  id                 String           @id @default(uuid())
  friendSourceLinkId String
  trackingSessionId  String           @unique
  clickedAt          DateTime         @default(now())
  referrer           String?
  userAgent          String?
  ipHash             String?
  friendSourceLink   FriendSourceLink @relation(fields: [friendSourceLinkId], references: [id], onDelete: Cascade)

  @@index([friendSourceLinkId, clickedAt])
}

model FriendSourceAttribution {
  id                 String                  @id @default(uuid())
  friendSourceLinkId String
  trackingSessionId  String?
  lineUserIdHash     String?
  followedAt         DateTime
  status             FriendAttributionStatus
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  friendSourceLink   FriendSourceLink        @relation(fields: [friendSourceLinkId], references: [id], onDelete: Cascade)

  @@index([friendSourceLinkId, status])
  @@index([trackingSessionId])
}

model FriendAttributionSession {
  id                     String                         @id @default(uuid())
  publicSessionTokenHash String                         @unique
  friendSourceLinkId     String
  lineOaId               String
  source                 FriendSource
  liffId                 String?
  clickedAt              DateTime                       @default(now())
  expiresAt              DateTime
  identifiedAt           DateTime?
  lineUserIdHash         String?
  friendshipBefore       Boolean?
  friendshipAfter        Boolean?
  confirmedFollowAt      DateTime?
  attributionStatus      FriendAttributionSessionStatus @default(CLICKED)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  friendSourceLink    FriendSourceLink    @relation(fields: [friendSourceLinkId], references: [id], onDelete: Cascade)
  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOaId], references: [id], onDelete: Cascade)

  @@index([publicSessionTokenHash])
  @@index([lineOaId, lineUserIdHash])
  @@index([attributionStatus, expiresAt])
  @@index([confirmedFollowAt])
}

model FriendAttributionUnmatchedFollow {
  id             String    @id @default(uuid())
  lineOaId       String
  lineUserIdHash String
  receivedAt     DateTime  @default(now())
  expiresAt      DateTime
  consumedAt     DateTime?

  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOaId], references: [id], onDelete: Cascade)

  @@index([lineOaId, lineUserIdHash, consumedAt])
  @@index([expiresAt])
}

model FriendAttributionConfig {
  id                 String              @id @default(uuid())
  lineOaId           String              @unique
  lineLoginChannelId String
  liffId             String
  isEnabled          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lineOa             LineOfficialAccount @relation(fields: [lineOaId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
}

model OperationalActionTask {
  id                String   @id @default(uuid())
  storeId           String
  storeName         String
  problem           String
  rootCause         String
  actionType        String
  recommendedAction String
  owner             String
  deadline          String
  priority          String   @default("HIGH")
  status            String   @default("PENDING_APPROVAL")
  expectedImpact    String
  createdAt         DateTime @default(now())

  @@index([storeId, status])
  @@index([createdAt])
}

model ActionImpactResult {
  id                 String   @id @default(uuid())
  taskId             String
  storeId            String
  storeName          String
  beforeSla          Float
  afterSla           Float
  beforePending      Int
  afterPending       Int
  beforeResponseTime Float
  afterResponseTime  Float
  impactScore        Float
  effectiveness      String
  improvementSummary String
  learnedPattern     String
  evaluatedAt        DateTime @default(now())

  @@index([storeId])
  @@index([effectiveness])
  @@index([evaluatedAt])
}

model OperationalMemoryCase {
  id                String   @id @default(uuid())
  storeId           String
  storeName         String
  problemPattern    String
  rootCauseCategory String
  successfulAction  String
  confidence        Float
  timesApplied      Int      @default(1)
  avgSlaLiftPct     Float
  lastAppliedAt     DateTime @default(now())

  @@index([storeId])
  @@index([rootCauseCategory])
}

enum MassMessageAudienceType {
  ALL_KNOWN
  NOT_REPLIED
  NOTIFIED_BM
  REPLIED
  SELECTED_USERS
}

enum MassMessageStoreMode {
  SINGLE
  MULTIPLE
  ALL
}

enum MassMessageCampaignStatus {
  DRAFT
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum MassMessageStoreDeliveryStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum MassMessageBatchStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model MassMessageCampaign {
  id                      String                    @id @default(uuid())
  campaignRequestId       String                    @unique
  title                   String?
  audienceType            MassMessageAudienceType   @default(ALL_KNOWN)
  storeMode               MassMessageStoreMode      @default(SINGLE)
  selectedStoreIds        String[]                  @default([])
  messagePayload          Json
  status                  MassMessageCampaignStatus @default(PENDING)
  createdById             String?
  createdBy               User?                     @relation("CreatedMassMessageCampaigns", fields: [createdById], references: [id], onDelete: SetNull)

  storeCount              Int                       @default(0)
  eligibleStoreCount      Int                       @default(0)
  skippedStoreCount       Int                       @default(0)

  estimatedRecipientCount Int                       @default(0)
  processedRecipientCount Int                       @default(0)
  successRecipientCount   Int                       @default(0)
  failedRecipientCount    Int                       @default(0)

  errorMessage            String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  storeDeliveries         MassMessageStoreDelivery[]

  @@index([status, createdAt])
  @@index([createdById])
  @@index([campaignRequestId])
}

model MassMessageStoreDelivery {
  id                    String                         @id @default(uuid())
  campaignId            String
  storeId               String
  lineOfficialAccountId String?
  status                MassMessageStoreDeliveryStatus @default(PENDING)

  recipientCount        Int                            @default(0)
  processedCount        Int                            @default(0)
  successCount          Int                            @default(0)
  failedCount           Int                            @default(0)

  skipReason            String?
  errorCode             String?
  errorMessage          String?

  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  campaign              MassMessageCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  store                 Store                          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lineOfficialAccount   LineOfficialAccount?           @relation(fields: [lineOfficialAccountId], references: [id], onDelete: SetNull)
  batches               MassMessageBatch[]

  @@unique([campaignId, storeId])
  @@index([campaignId, status])
  @@index([storeId])
  @@index([status])
}

model MassMessageBatch {
  id                String                 @id @default(uuid())
  storeDeliveryId   String
  batchIndex        Int
  retryKey          String
  recipientCount    Int                    @default(0)
  status            MassMessageBatchStatus @default(PENDING)
  lineRequestId     String?
  acceptedRequestId String?
  externalMessageId String?
  attemptCount      Int                    @default(0)
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  storeDelivery     MassMessageStoreDelivery @relation(fields: [storeDeliveryId], references: [id], onDelete: Cascade)

  @@unique([storeDeliveryId, batchIndex])
  @@index([status])
  @@index([retryKey])
}
