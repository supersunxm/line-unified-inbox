  intent                AutoResponseIntent?
  matcherVersion        Int?
  mode                  AutoResponsePilotMode?
  outcome               AutoResponseExecutionOutcome?
  exclusionReason       String?
  status                AutoResponseExecutionStatus
  reason                String?
  messageCount          Int?
  messageTypesJson      Json?
  resolvedVariablesJson Json?
  createdAt             DateTime                    @default(now())

  rule                AutoResponseRule?   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOfficialAccountId], references: [id], onDelete: Cascade)
  sourceMessage       Message?            @relation("AutoResponseSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  conversation        Conversation?       @relation("ConversationAutoResponseExecutions", fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt])
  @@index([lineOfficialAccountId, createdAt])
  @@index([createdAt])
  @@index([webhookEventId])
  @@index([conversationId, createdAt])
  @@index([intent, outcome, createdAt])
}

enum GreetingTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum GreetingSendPolicy {
  FIRST_TIME_ONLY
  ADD_AND_UNBLOCK
}

enum GreetingExecutionStatus {
  SUCCESS
  SKIPPED
  FAILED
}

model GreetingTemplate {
  id              String                 @id @default(uuid())
  name            String
  description     String?
  status          GreetingTemplateStatus @default(DRAFT)
  sendPolicy      GreetingSendPolicy     @default(FIRST_TIME_ONLY)
  contentJson     Json?
  version         Int                    @default(1)
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  activatedAt     DateTime?
  archivedAt      DateTime?

  assignments GreetingStoreAssignment[]
  executions  GreetingExecution[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model GreetingStoreAssignment {
  id                    String              @id @default(uuid())
  templateId            String
  lineOfficialAccountId String              @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  template            GreetingTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOfficialAccountId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model GreetingExecution {
  id                    String                  @id @default(uuid())
  templateId            String?
  lineOfficialAccountId String
  webhookEventId        String?
  lineUserIdHash        String
  status                GreetingExecutionStatus
  reason                String?
  messageCount          Int?
  messageTypesJson      Json?
  isUnblocked           Boolean?
  createdAt             DateTime                @default(now())

  template            GreetingTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOfficialAccountId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([lineOfficialAccountId, createdAt])
  @@index([lineOfficialAccountId, lineUserIdHash, status])
  @@index([webhookEventId])
  @@index([createdAt])
}

enum LineChatNicknameSyncJobStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  FAILED_AUTH
  SUPERSEDED
}

enum LineChatSessionStatus {
  ACTIVE
  INACTIVE
  AUTH_REQUIRED
  DISABLED
}

model LineChatSession {
  id                      String                @id @default(uuid())
  sessionKey              String                @unique
  displayName             String
  profilePath             String?
  profileStorageKey       String?
  status                  LineChatSessionStatus @default(ACTIVE)
  lastAuthenticatedAt     DateTime?
  lastSuccessfulRequestAt DateTime?
  lastAuthFailureAt       DateTime?
  consecutiveAuthFailures Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  lineOfficialAccounts LineOfficialAccount[]

  @@index([status])
}

model LineChatNicknameSyncJob {
  id                    String                        @id @default(uuid())
  conversationId        String
  lineOfficialAccountId String
  lineChatUserId        String?
  lineUserId            String?
  nickname              String
  status                LineChatNicknameSyncJobStatus @default(PENDING)
  attemptCount          Int                           @default(0)
  maxAttempts           Int                           @default(3)
  lastError             String?
  workerId              String?
  claimedAt             DateTime?
  lockedUntil           DateTime?
  scheduledAt           DateTime                      @default(now())
  processedAt           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  conversation        Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lineOfficialAccount LineOfficialAccount @relation(fields: [lineOfficialAccountId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([status, lockedUntil])
  @@index([conversationId, status])
  @@index([lineOfficialAccountId, status])
  @@index([lineChatUserId])
  @@index([createdAt])
}
