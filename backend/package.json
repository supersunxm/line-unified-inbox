{
  "name": "oppo-line-oa-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start:prod": "node dist/main.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:seed:demo": "tsx prisma/demo-seed.ts",
    "prisma:studio": "prisma studio",
    "test": "tsx --test src/*.spec.ts src/**/*.spec.ts src/**/**/*.spec.ts",
    "test:line-webhook": "tsx --env-file=.env scripts/send-test-line-webhook.ts",
    "test:line-verify": "tsx --env-file=.env scripts/send-test-line-verify.ts",
    "test:line-onboarding": "tsx --env-file=.env scripts/test-line-oa-onboarding.ts",
    "worker:rich-menu-publish": "tsx src/rich-menu/rich-menu-worker.ts",
    "worker:rich-menu-publish:prod": "node dist/rich-menu/rich-menu-worker.js",
    "store-master:import": "tsx --env-file=.env scripts/store-master.ts import",
    "store-master:validate": "tsx --env-file=.env scripts/store-master.ts validate",
    "store-master:sync-connected-line-oa": "tsx --env-file=.env scripts/sync-connected-line-oa-store-master.ts",
    "tiktok:sync-daily-metrics": "tsx scripts/sync-tiktok-daily-metrics.ts",
    "user:create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "auth:status": "tsx --env-file=.env scripts/auth-status.ts",
    "product-catalog:validate": "tsx scripts/product-catalog.ts validate",
    "product-catalog:seed": "tsx --env-file=.env scripts/product-catalog.ts seed",
    "product-master:dry-run": "tsx --env-file=.env src/product-master-sync-cli.ts",
    "product-master:sync": "tsx --env-file=.env src/product-master-sync-cli.ts --apply",
    "product-alias:adopt-phase1": "tsx scripts/adopt-product-alias-ownership.ts",
    "translation:benchmark": "tsx scripts/translation-benchmark.ts",
    "translation:benchmark:generate-google": "tsx scripts/translation-benchmark-generate-google.ts",
    "translation:pilot:smoke-test": "tsx scripts/translation-pilot-smoke-test.ts",
    "translation:pilot:preflight": "tsx scripts/translation-pilot-preflight.ts",
    "translation:pilot:check": "tsx scripts/translation-pilot-check.ts",
    "translation:pilot:release-check": "tsx scripts/translation-pilot-release-check.ts",
    "translation:glossary:smoke-test": "tsx scripts/translation-glossary-smoke-test.ts",
    "translation:quality:report": "tsx scripts/translation-quality-report.ts",
    "classification:backfill-products": "tsx --env-file=.env scripts/backfill-product-classifications.ts",
    "product:reanalyze": "tsx --env-file=.env scripts/reanalyze-products.ts",
    "line-oa:backfill-webhook-keys": "tsx --env-file=.env scripts/backfill-line-oa-webhook-keys.ts",
    "media:google-drive:oauth": "tsx --env-file=.env scripts/google-drive-oauth-setup.ts",
    "security:check": "sh scripts/security-check.sh",
    "db:backup": "sh -c '. ./.env && sh scripts/db-backup.sh'",
    "db:restore": "sh -c '. ./.env && sh scripts/db-restore.sh \"$@\"' --"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@google-cloud/translate": "^9.4.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "firebase-admin": "^14.2.0",
    "image-size": "^2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
