DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NODE_ENV=development
# Railway supplies PORT automatically. Local development defaults to 3001.
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Enable only after configuring a pilot LINE Official Account.
LINE_WEBHOOK_ENABLED=false
# Public HTTPS URL that forwards to this backend, for example https://example.ngrok-free.app
# Do not use localhost. A trailing slash is optional; the app appends /webhook/:webhookKey safely.
# Leave blank to start without LINE webhooks; the management page will show setup guidance.
PUBLIC_WEBHOOK_BASE_URL=""
# Required 32-byte Base64 key for encrypting each OA's Channel Secret and Access Token.
# Keep this private and stable: changing it makes already saved credentials unreadable.
# Generate with: openssl rand -base64 32
LINE_CREDENTIAL_ENCRYPTION_KEY=""

# Firebase Cloud Messaging — backend-only service account credentials. Do not expose to clients.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Inbound LINE media is optional and disabled unless explicitly enabled.
MEDIA_STORAGE_ENABLED=false
# For production R2, set MEDIA_STORAGE_ENABLED=true and MEDIA_STORAGE_DRIVER=s3.
# Local is development-only; production requires S3-compatible persistent storage.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_DIRECTORY=".media"
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_DOWNLOAD_TIMEOUT_MS=10000
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="oppo-line-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional public base URL for future signed/public delivery. Current UI uses the authenticated backend media endpoint.
S3_PUBLIC_BASE_URL=""

# Deprecated legacy Google Drive media storage. Keep disabled when using R2.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# Public Google Sheet containing Store Master rows. The importer converts this to CSV.
# For a local CSV instead, run: npm run store-master:import -- /absolute/path/store-master.csv
STORE_MASTER_GOOGLE_SHEET_URL=""
PILOT_MODE=true
PILOT_ADMIN_BOOTSTRAP_ENABLED=false
PILOT_ADMIN_USERNAME=
PILOT_ADMIN_PASSWORD=
PILOT_ADMIN_DISPLAY_NAME=Pilot Admin
# Production: use "none" if first-admin email setup is disabled, or "resend" with the credentials below.
# "console" is development-only and fails production startup.
EMAIL_PROVIDER=none
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_FROM_NAME="OPPO LINE OA Monitor"
DEV_ADMIN_ENABLED=false
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=123admin

# Manual message translation remains unavailable unless both flags are explicitly enabled.
MESSAGE_TRANSLATION_ENABLED=false
TRANSLATION_PILOT_MODE=false
# Comma-separated authenticated User.id values for internal ADMIN users (not display names). Empty denies all pilot translation access.
TRANSLATION_PILOT_ALLOWED_ADMIN_IDS=
TRANSLATION_PROVIDER=none
# Required only when the feature, Google provider, and pilot mode are enabled.
GOOGLE_TRANSLATION_PROJECT_ID=
GOOGLE_TRANSLATION_CREDENTIALS_JSON=
# Per backend process and acting user; applies only to uncached provider requests.
TRANSLATION_RATE_LIMIT_PER_MINUTE=20
# Process-local uncached provider character budget, reset at midnight Asia/Bangkok.
TRANSLATION_DAILY_CHARACTER_LIMIT=50000
